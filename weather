			pos       = pos,
			age       = 0,
			maxAge    = 12 + math.random() * 8,
			swayPhase = swayPhase,
			swaySpeed = swaySpeed,
			swayAmp   = swayAmp,
			spinSpeed = spinSpeed,
			fallSpeed = fallSpeed,
		})
	end
	local function cherryStart()
		if cherryConn then return end
		local cfg = cherryGetCfg()
		local spawnTimer  = 0
		local tAccCherry  = 0
		local _cherrySlowFrame = 0
		cherryConn = RunService.RenderStepped:Connect(function(dt)
			LPH_ATTRIBUTES(PRESET(FAST), OPTIMIZE(3), VM(NONE))
			local ok = pcall(function()
				cfg = cherryGetCfg()
				if not cfg.Enabled then
					cherryStop()
					return
				end
				tAccCherry = tAccCherry + dt
				_cherrySlowFrame = _cherrySlowFrame + 1
				local doSlowProps = (_cherrySlowFrame % 4 == 0)
				local base    = workspace.CurrentCamera and workspace.CurrentCamera.CFrame.Position or Vector3.new(0, 0, 0)
				local maxP    = math.max(1, tonumber(cfg.MaxPetals) or 60)
				local rate    = math.max(0.1, tonumber(cfg.SpawnRate) or 8)
				spawnTimer = spawnTimer + dt
				local interval = 1 / rate
				while spawnTimer >= interval and #cherryPetals < maxP do
					cherrySpawnPetal(base)
					spawnTimer = spawnTimer - interval
				end
				if spawnTimer > interval then spawnTimer = 0 end
				local color = cfg.Color or Color3.fromRGB(255, 182, 193)
				for i = #cherryPetals, 1, -1 do
					local petal = cherryPetals[i]
					local p = petal.part
					if not p or not p.Parent then
						table.remove(cherryPetals, i)
					else
						petal.age = petal.age + dt
						if petal.age >= petal.maxAge then
							p:Destroy()
							table.remove(cherryPetals, i)
						else
							local sway = math.sin(tAccCherry * petal.swaySpeed + petal.swayPhase) * petal.swayAmp
							local newX = petal.pos.X + sway * dt
							local newY = petal.pos.Y - petal.fallSpeed * dt
							local newZ = petal.pos.Z + math.cos(tAccCherry * petal.swaySpeed * 0.7 + petal.swayPhase) * petal.swayAmp * 0.4 * dt
							petal.pos = Vector3.new(newX, newY, newZ)
							local spinRad = math.rad(petal.spinSpeed * dt)
							p.CFrame = CFrame.new(petal.pos) * CFrame.Angles(spinRad * 0.6, spinRad, spinRad * 0.3)
							if doSlowProps then
								local t = petal.age / petal.maxAge
								p.Transparency = t > 0.8 and (t - 0.8) / 0.2 or 0.05
								p.Color = color
							end
						end
					end
				end
			end)
			if not ok then warn("[RELAPSE][Cherry] step error") end
		end)
	end
	cherryStop = function()
		if cherryConn then
			cherryConn:Disconnect()
			cherryConn = nil
		end
		for _, petal in ipairs(cherryPetals) do
			if petal.part and petal.part.Parent then
				petal.part:Destroy()
			end
		end
		cherryPetals = {}
	end
	local _origApplyPreset = Weather.applyPreset
	Weather.applyPreset = function(name)
		if name == "CherryBlossom" then
			_origApplyPreset("None")
			local cfg = getgenv().RELAPSE.weather
			cfg.Preset  = "CherryBlossom"
			cfg.Enabled = true
			cfg.Cherry.Enabled = true
