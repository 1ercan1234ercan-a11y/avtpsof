		else
			if getgenv().RELAPSE.weather.Preset == "CherryBlossom" then
				getgenv().RELAPSE.weather.Cherry.Enabled = false
				cherryStop()
			end
			_origApplyPreset(name)
		end
	end
	Weather.cherryStop = cherryStop
