	function Weather.applyPreset(name)
		local w = WCFG()
		w.Preset = name
		active = PRESETS[name] or PRESETS.None
		w.Enabled = (name ~= "None")
		if not w.Enabled then
			for _, e in pairs(emitters) do
				if e and e.Parent then e.Enabled = false; e.Rate = 0 end
			end
			if flashLight then flashLight.Enabled = false; flashLight.Brightness = 0 end
			if cc then cc.Enabled = false; cc.Brightness = 0 end
			if rainCC then rainCC.Enabled = false end
			if boltFolder then boltFolder:ClearAllChildren() end
			pcall(function() if thunderSound then thunderSound:Stop(); thunderSound:Destroy(); thunderSound = nil end end)
			pcall(function() if windSound then windSound:Stop(); windSound:Destroy(); windSound = nil end end)
			pcall(function() if rainSound then rainSound:Stop(); rainSound.Volume = 0 end end)
			flash = 0
			_impactAccumulator = 0
			fallbackImpactTimer = 0
			clearGroundEffects()
			destroySyncDrops()
			return
		end
		if not ensureEmitters() then
			warn("[RELAPSE][Weather] Unknown preset '" .. tostring(name) .. "', ignoring")
			return
		end
		local groundFX = not (WCFG().GroundFX == false)
		local rates = {
			RainFront = active.rainFront, RainNear = active.rainNear, RainMid = active.rainMid, RainFar = active.rainFar,
			Snow = active.snow, SnowFar = active.snowFar,
			Sand = active.sand,
			Splash = groundFX and active.splash or 0, Ripple = groundFX and active.ripple or 0, Mist = groundFX and active.mist or 0
		}
		local intensity = math.max(0, tonumber(w.Intensity) or 1)
		local isRainPreset = (name == "Rain" or name == "Thunderstorm")
		local isSnowPreset = (name == "Snow")
		if isRainPreset and w.Rain and w.Rain.Rate then
			local userRate = tonumber(w.Rain.Rate) or 60
			local scale = userRate / 120
			rates.RainFront = (active.rainFront or 0) * scale
			rates.RainNear  = (active.rainNear  or 0) * scale
			rates.RainMid   = (active.rainMid   or 0) * scale
			rates.RainFar   = (active.rainFar   or 0) * scale
		end
		if isSnowPreset and w.Snow and w.Snow.Rate then
			local userRate = tonumber(w.Snow.Rate) or 220
			local scale = userRate / 620
			rates.Snow    = (active.snow    or 0) * scale
			rates.SnowFar = (active.snowFar or 0) * scale
		end
		for name, e in pairs(emitters) do
			if e and e.Parent then
				local rate = (rates[name] or 0) * intensity
				e.Rate = rate
				e.Enabled = rate > 0
			end
		end
		if isRainPreset then
			local rainSize = tonumber(w.Rain and w.Rain.Size) or 0.7
			local rainWidth = tonumber(w.Rain and w.Rain.Width) or 28
			local squashVal = -(rainWidth / 10)
			for _, rname in ipairs({"RainFront","RainNear","RainMid","RainFar"}) do
				local e = emitters[rname]
				if e and e.Parent then
					e.Size = NumberSequence.new(rainSize)
					pcall(function() e.Squash = NumberSequence.new(squashVal) end)
				end
			end
			local radius = tonumber(w.Rain and w.Rain.Radius) or 154
			if rig then rig.Size = Vector3.new(radius * 2, 10, radius * 2) end
			if rigMid then rigMid.Size = Vector3.new(radius * 2.4, 12, radius * 2.4) end
			if rigFar then rigFar.Size = Vector3.new(radius * 3.2, 15, radius * 3.2) end
			if not (w.Rain and w.Rain.Splash ~= false) then
				if emitters.Splash then emitters.Splash.Rate = 0; emitters.Splash.Enabled = false end
				if emitters.Ripple then emitters.Ripple.Rate = 0; emitters.Ripple.Enabled = false end
			end
		end
		local rainColor = w.Rain and w.Rain.Color
		if rainColor and typeof(rainColor) == "Color3" then
			for _, name in ipairs({"RainFront", "RainNear", "RainMid", "RainFar"}) do
				if emitters[name] then emitters[name].Color = ColorSequence.new(rainColor) end
			end
		end
		local rainSpeed = math.max(10, tonumber(w.Rain and w.Rain.Speed) or 70)
		if active.rainNear then
			if emitters.RainFront then emitters.RainFront.Speed = NumberRange.new(rainSpeed * 1.15, rainSpeed * 1.55) end
			if emitters.RainNear then emitters.RainNear.Speed = NumberRange.new(rainSpeed * 1.00, rainSpeed * 1.35) end
			if emitters.RainMid then emitters.RainMid.Speed = NumberRange.new(rainSpeed * 0.90, rainSpeed * 1.20) end
			if emitters.RainFar then emitters.RainFar.Speed = NumberRange.new(rainSpeed * 0.80, rainSpeed * 1.08) end
		end
		if isSnowPreset then
			local snowColor = w.Snow and w.Snow.Color
			if snowColor and typeof(snowColor) == "Color3" then
				if emitters.Snow    then emitters.Snow.Color    = ColorSequence.new(snowColor) end
				if emitters.SnowFar then emitters.SnowFar.Color = ColorSequence.new(snowColor) end
			end
			local snowSpeed = math.max(1, tonumber(w.Snow and w.Snow.Speed) or 12)
			if emitters.Snow    then emitters.Snow.Speed    = NumberRange.new(snowSpeed * 0.8, snowSpeed * 1.2) end
			if emitters.SnowFar then emitters.SnowFar.Speed = NumberRange.new(snowSpeed * 0.4, snowSpeed * 0.8) end
			local snowSize = math.max(0.01, tonumber(w.Snow and w.Snow.Size) or 5) * 0.01
			if emitters.Snow    then emitters.Snow.Size    = NumberSequence.new(snowSize) end
			if emitters.SnowFar then emitters.SnowFar.Size = NumberSequence.new(snowSize * 0.55) end
		end
		if rainCC then rainCC.Enabled = false end
		if rainSound and rainSound.Parent then
			pcall(function()
				rainSound.Volume = 0
				rainSound:Play()
				TweenService:Create(rainSound, TweenInfo.new(2), {Volume = 1.2}):Play()
			end)
		end
		if name == "Thunderstorm" then
			getgenv().__RELAPSE_WIND_PENDING = true
		else
			getgenv().__RELAPSE_WIND_PENDING = false
			pcall(function() if windSound then windSound:Stop(); windSound:Destroy(); windSound = nil end end)
		end
		nextStrike = tick() + (active.lightning or 999)
		local cam = resolveCamera()
		rigAnchor = cam and cam.CFrame.Position or Vector3.new(0, 0, 0)
	end
