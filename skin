        if root:IsA("BasePart") then table.insert(parts, root) end
        for _, desc in ipairs(root:GetDescendants()) do
            if desc:IsA("BasePart") then table.insert(parts, desc) end
        end
        for _, part in ipairs(parts) do
            if part ~= pp then
                local wi = Instance.new("WeldConstraint")
                wi.Part0 = pp
                wi.Part1 = part
                wi.Parent = pp
            end
            local w = Instance.new("WeldConstraint")
            w.Name = "RELAPSE_SkinWeld"
            w.Part0 = handle
            w.Part1 = part
            w.Parent = handle
        end
    end
    weldAllParts(clone)
    local skinParts = {}
    if clone:IsA("BasePart") then table.insert(skinParts, clone) end
    for _, p in ipairs(clone:GetDescendants()) do
        if p:IsA("BasePart") then table.insert(skinParts, p) end
    end
    for _, p in ipairs(skinParts) do
        p.Anchored = true
        p.Massless = true
    end
    handle.Transparency = 1
    if default and default:IsA("BasePart") then default.Transparency = 1 end
    task.defer(function()
        for _, p in ipairs(skinParts) do
            if p and p.Parent then
                p.Anchored = false
            end
        end
    end)
end
